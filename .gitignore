# ==========================================
# VyaperiX Root .gitignore
# ==========================================

# ------------------------------------------
# Dependencies & Package Managers
# ------------------------------------------
node_modules/
**/node_modules/
.pnp/
.pnp.js
.yarn/cache/
.yarn/unplugged/
.yarn/build-state.yml
.yarn/install-state.gz

# ------------------------------------------
# Environment Variables & Secrets (CRITICAL)
# ------------------------------------------
.env
.env.*
*.env
*.env.*
# Keep example / template files tracked
!.env.example
!.env.*.example
!*.env.example
!backend/.env.example
!frontend/.env.example

# ------------------------------------------
# WhatsApp Gateway (Baileys Session & Auth)
# ------------------------------------------
whatsapp-gateway/auth_info/
whatsapp-gateway/auth_info_baileys/
whatsapp-gateway/session*/
whatsapp-gateway/.auth/

# ------------------------------------------
# Python & FastAPI Backends
# ------------------------------------------
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Python Virtual Environments
.venv/
**/.venv/
venv/
**/venv/
env/
**/env/
ENV/
env.bak/
venv.bak/

# Python Build & Test Caches
*.egg-info/
.installed.cfg
*.egg
build/
develop-eggs/
downloads/
eggs/
.eggs/
parts/
var/
wheels/
share/python-wheels/
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
.coverage.*
.hypothesis/

# ------------------------------------------
# Frontend Build Outputs & Caches
# ------------------------------------------
dist/
**/dist/
.output/
**/.output/
.tanstack/
.vercel
.turbo
.next/
out/
.eslintcache
*.tsbuildinfo
.vite/

# ------------------------------------------
# Databases & Local Storage
# ------------------------------------------
*.sqlite
*.sqlite3
*.db
mongodb_data/
**/mongodb_data/
backend/mongodb_data/
supabase/.temp/
.temp/
tmp/
temp/

# ------------------------------------------
# Logs & Process Artifacts
# ------------------------------------------
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ------------------------------------------
# Operating System Files
# ------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# ------------------------------------------
# IDE & Editor Configurations
# ------------------------------------------
.idea/
*.sublime-project
*.sublime-workspace
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.swp
*.swo
*~

# ------------------------------------------
# Video, Heavy Media & ML Artifacts
# ------------------------------------------
drive-download-*/
tools/upscayl-repo/
tools/*.webp
tools/*.png
tools/model_tests/
frontend/public/sample_4k/*.png
!frontend/public/videos/*.mp4
